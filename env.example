# Local development template. Copy to .env and fill in.
#
#   cp env.example .env
#
# .env is git-ignored. Never commit a real connection string -- in the
# workspace it lives only in a Databricks secret scope, and app.yaml refers
# to it by name.

# ---------------------------------------------------------------- Lakebase --
LAKEBASE_URL=postgresql://USER:PASSWORD@INSTANCE.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Where the app looks for that DSN when LAKEBASE_URL is unset. These are the
# defaults; matches app.yaml.
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=lakebase-url

# Schema this project's tables live in. Defaults to "weather", not "public",
# so it can share a Lakebase instance with another app (e.g. another
# bootcamp homework) with zero risk of a table-name collision. Created
# automatically if missing.
# LAKEBASE_SCHEMA=weather

# No static password anywhere: leave LAKEBASE_URL unset, give a host, and the
# app mints a short-lived credential from its own Databricks identity.
# PGHOST=INSTANCE.database.cloud.databricks.com
# PGUSER=you@example.com
# LAKEBASE_INSTANCE_NAME=INSTANCE

# ---------------------------------------------------- National Weather Service --
NWS_USER_AGENT=lakebase-weather-rag (bootcamp homework; contact via github.com/DolfusNegunda)
# NWS_API_BASE_URL=https://api.weather.gov
# WEATHER_DEFAULT_LOCATIONS=Chicago, IL|Austin, TX|Miami, FL

# ------------------------------------------------------------- Embeddings --
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers

# ----------------------------------------------- Optional: RAG summaries --
# FOUNDATION_MODEL_ENDPOINT=databricks-meta-llama-3-1-70b-instruct

# ------------------------------------------------------------------ Server --
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=8000
